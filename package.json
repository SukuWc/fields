{
  "name": "fields",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "vite",
    "test": "npm run test:unit && npm run test:timing",
    "test:unit": "node --test --import ./test/register.mjs \"test/*.test.mjs\"",
    "test:timing": "node --test --test-concurrency=1 --import ./test/register.mjs \"test/*.timing.mjs\"",
    "build": "vite build",
    "build:app": "node scripts/build-app.mjs",
    "build:server": "esbuild apps/server/index.js --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/server.mjs --log-level=warning \"--banner:js=import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "server": "npm run build:server && node dist-server/server.mjs",
    "serve:app": "npm run build:app && npm run build:server && node dist-server/server.mjs --static dist-app",
    "smoke:server": "node scripts/server-smoke.mjs",
    "check:all": "node scripts/check-all.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SukuWc/fields.git"
  },
  "author": "SukuWc",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SukuWc/fields/issues"
  },
  "homepage": "https://github.com/SukuWc/fields#readme",
  "dependencies": {
    "planck-js": "^0.3.31",
    "smol-toml": "^1.9.1",
    "three": "^0.183.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "vite": "^7.3.1"
  }
}
